# --- TigerData (Timescale) ---
# Paste the connection string from the TigerData console (Service > Connect).
# Format: postgresql://tsdbadmin:<password>@<host>.tsdb.cloud.timescale.com:<port>/tsdb?sslmode=require
TIGERDATA_URL=postgresql://tsdbadmin:CHANGEME@HOST.tsdb.cloud.timescale.com:5432/tsdb?sslmode=require

# Optional: skip the DB entirely and run everything in memory (demo-safe default)
USE_DATABASE=false

# --- Server ---
CORS_ORIGINS=http://localhost:5173
OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast
